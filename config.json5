{
    // The message to send when bot is on. Empty ('') won't send message
    initMessage: '',

    // After wake a device, the bot will send a message when device is on
    notificationWhenDeviceIsOn: true,

    // Devices you want to wake up
    devices: [
        {
            // Example input: '00:1a:2b:3c:4d:5e'
            macAddress: '',
            // Used to check if device is waked. Can be empty or not informed
            ipAddress: '',
            // Alias name (no whitespaces), must be unique
            nameId: '',
            // Telegram usernames allowed to wake this device. Starts with `@`. 'all' allows all
            telegramUsernamesAuthorizedToWake: ['all'],
        },
    ],

    // `/start` command won't never be processed as restricted
    restrictedCommands: [
        {
            command: '/ping',
            // In seconds
            cooldownSecs: 5,
            // Telegram usernames allowed to execute this command. Starts with `@`. 'all' allows all. Can be empty
            allowedTelegramUsernames: ['all'],
        },
        {
            command: '/reload',
            cooldownSecs: 5,
            allowedTelegramUsernames: ['all'],
        },
    ],
}