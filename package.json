{
  "name": "remote-wol-server",
  "version": "0.0.1",
  "description": "WebSocket relay server that triggers Wake-On-LAN (WOL) commands on remote local networks",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --allow-fs-read=* --allow-fs-write=* --allow-worker=* --allow-child-process --watch --import tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.{ts,json}\""
  },
  "keywords": [
    "wol",
    "wake-on-lan",
    "express",
    "api"
  ],
  "author": "GinesMister",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "express": "5.2.1",
    "ws": "8.20.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "25.5.0",
    "@types/ws": "8.18.1",
    "eslint": "10.1.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.8.1",
    "tsx": "4.21.0",
    "typescript": "6.0.2"
  }
}
