{
  "name": "telegram-wol-bot",
  "version": "0.0.1",
  "description": "Remotely wake up computers on a local network using Telegram commands, secured by user ID validation.",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "dev:inspect": "node --max-old-space-size=100 --inspect --watch --import tsx src/index.ts",
    "build": "node ./node_modules/typescript/bin/tsc && pnpm build:cpAssets",
    "build:cpAssets": "pnpm build:cpConfig && pnpm build:cpLocales",
    "build:cpConfig": "copyfiles -u 0 \"config.json5\" dist/",
    "build:cpLocales": "copyfiles -u 0 locales/**/* dist",
    "start": "node dist/src/index.js",
    "start:limitedMemory": "node --max-old-space-size=100 dist/src/index.js",
    "lint": "node --permission --allow-fs-read=* ./node_modules/eslint/bin/eslint.js src/",
    "format": "node --permission --allow-fs-read=* --allow-fs-write=* ./node_modules/prettier/bin/prettier.cjs --write \"src/**/*.{ts,json}\""
  },
  "keywords": [
    "wol",
    "wake-on-lan",
    "telegram-bot"
  ],
  "author": "GinesMister",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "dotenv": "17.4.0",
    "i18next": "26.0.3",
    "i18next-fs-backend": "2.6.3",
    "json5": "2.2.3",
    "ping": "1.0.0",
    "telegraf": "4.16.3",
    "wake_on_lan": "1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "25.5.0",
    "@types/wake_on_lan": "0.0.33",
    "copyfiles": "2.4.1",
    "eslint": "10.1.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.8.1",
    "tsx": "4.21.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.58.0"
  }
}
