{
  "name": "remote-wol-server",
  "version": "0.0.1",
  "description": "WebSocket relay server that triggers Wake-On-LAN (WOL) commands on remote local networks",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --allow-fs-read=* --allow-fs-write=* --allow-worker=* --allow-child-process --watch --import tsx src/index.ts",
    "build": "node --allow-fs-read=* --allow-fs-write=* ./node_modules/typescript/bin/tsc && node --allow-fs-read=* --allow-fs-write=* ./node_modules/copyfiles/copyfiles -u 1 \"src/config.json5\" dist/",
    "start": "node dist/index.js",
    "lint": "node --allow-fs-read=* ./node_modules/eslint/bin/eslint.js src/",
    "format": "node --allow-fs-read=* --allow-fs-write=* ./node_modules/prettier/bin/prettier.cjs --write \"src/**/*.{ts,json}\""
  },
  "keywords": [
    "wol",
    "wake-on-lan",
    "express",
    "api"
  ],
  "author": "GinesMister",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "dotenv": "17.4.0",
    "express": "5.2.1",
    "json5": "2.2.3",
    "ws": "8.20.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "25.5.0",
    "@types/ws": "8.18.1",
    "copyfiles": "2.4.1",
    "eslint": "10.1.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.8.1",
    "tsx": "4.21.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.58.0"
  }
}
